{
	"buildCommand": "npm run build:all",
	"outputDirectory": "dist",
	"rewrites": [
		{
			"source": "/storybook/:path*",
			"destination": "/storybook/:path*"
		},
		{
			"source": "/storybook",
			"destination": "/storybook/index.html"
		},
		{
			"source": "/(.*)",
			"destination": "/index.html"
		}
	]
}
